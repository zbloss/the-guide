# The Guide — environment variable reference
# Copy to .env and customise

# GUIDE__CHUNK_MAX_CHARS=2048          # max chars per RAG chunk
# GUIDE__CHUNK_OVERLAP_CHARS=64        # overlap between adjacent chunks
# GUIDE__CLOUD_API_KEY=AIza...         # API key for the chosen cloud provider
# GUIDE__CLOUD_FALLBACK=gemini         # "openai" or "gemini"
# GUIDE__CLOUD_MODEL=gemini-2.5-flash  # override default cloud model
GUIDE__CONTEXT_WINDOW=8192             # tokens; all LLM budgets scale from this
GUIDE__DATABASE_URL=/app/data/guide.db
GUIDE__DEFAULT_MODEL=qwen3:14b
# GUIDE__EMBEDDING_MODEL=onnx-community/embeddinggemma-300m-ONNX  # model used for all embedding providers
# GUIDE__EMBEDDING_PROVIDER=local      # "local" | "ollama" | "cloud" (default: local)
GUIDE__HOST=0.0.0.0
# GUIDE__MAX_CHAPTER_CHARS=20000       # hard cap on chars per chapter in story extraction
GUIDE__MAX_UPLOAD_BYTES=524288000      # 500 MB
GUIDE__OCR_MODEL=glm-ocr
# GUIDE__OCR_PROVIDER=cloud            # default: local (glm-ocr via Ollama)
GUIDE__OLLAMA_BASE_URL=http://localhost:11434/v1
GUIDE__PORT=8000
# GUIDE__STORY_PROVIDER=cloud          # default: local (default_model via Ollama)
# GUIDE__ENABLE_RAG=false              # set to false to skip vector embedding + RAG retrieval (default: true)
# GUIDE__WHISPER_MODEL=whisper         # speech recognition model via Ollama
